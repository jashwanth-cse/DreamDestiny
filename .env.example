# ==============================================================================
# DREAM DESTINY — MASTER ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env before deploying:
#   cp .env.example .env
# Fill in your secure credentials below. NEVER commit .env to version control!
# ==============================================================================

# ── 1. General & Networking ──────────────────────────────────────────────────
APP_ENV=production
FRONTEND_ORIGIN=https://dreamdestiny.duckdns.org
HTTP_TIMEOUT=20.0
LLM_TIMEOUT=60.0

# ── 2. External Provider APIs ────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here
BEDROCK_API_KEY=your_bedrock_api_key_here

# ── 3. Meta WhatsApp Cloud API ───────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_VERIFY_TOKEN=dream_destiny_verify_token
WHATSAPP_APP_SECRET=your_whatsapp_app_secret_here
WHATSAPP_API_VERSION=v20.0

# ── 4. Google Cloud Firestore / Firebase ─────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# ── 5. Monitoring & Dashboard (Dozzle) ────────────────────────────────────────
DOZZLE_USERNAME=admin
DOZZLE_PASSWORD=your_secure_dozzle_password_here