# ==============================================================================
# DREAM DESTINY — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env before starting the stack:
#   cp .env.example .env
#
# Fill in your API keys below. Never commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Keys (Required for live external provider data & AI planning)
# ------------------------------------------------------------------------------
# Google Maps API Key (Used by tourism-service for Places API & route-service for Routes API)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# SerpApi Key (Used by hotel-service for Google Hotels engine)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Google Gemini API Key (Used by planner-service for AI itinerary generation)
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. General Settings
# ------------------------------------------------------------------------------
# CORS allowed frontend origin
FRONTEND_ORIGIN=http://localhost:3000

# Hotel cache expiration in hours (SQLite cache in hotel-service)
HOTEL_CACHE_TTL_HOURS=24

# Downstream HTTP client timeout in seconds (planner-service)
HTTP_TIMEOUT=20.0

# LLM inference timeout in seconds (planner-service)
LLM_TIMEOUT=60.0
