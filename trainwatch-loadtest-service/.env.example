# ==============================================================================
# TrainWatch Availability Load-Test Service — Configuration Template
# ==============================================================================

# GCP Project & Firestore Configuration
GCP_PROJECT_ID=trainwatch
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=trainwatch_load_test_runs
ENABLE_FIRESTORE=true

# Target Train Availability Service Endpoint
TARGET_AVAILABILITY_URL=https://dreamdestiny.cloud.run/api/v1/trains/availability

# Security / Defense-in-depth API Key (Optional in addition to Cloud Run IAM OIDC)
# If set, incoming POST /run must include 'X-API-Key: <value>' or 'Bearer <value>'
SERVICE_API_KEY=

# Safe Execution Guardrails (prevents runaway traffic / cloud cost spikes)
DEFAULT_SCENARIO=balanced
DEFAULT_CONCURRENCY=20
MAX_ALLOWED_CONCURRENCY=50
DEFAULT_TOTAL_REQUESTS=60
MAX_ALLOWED_REQUESTS=200
REQUEST_TIMEOUT_SECONDS=10.0
RUN_DEADLINE_SECONDS=120.0

# IRCTC Operational Blackout Windows (Maintenance & Tatkal rate-limit protection)
ENFORCE_BLACKOUT_WINDOWS=true
TIMEZONE=Asia/Kolkata

# Server Listening Port (Cloud Run injects PORT=8080 automatically)
PORT=8080
LOG_LEVEL=INFO
