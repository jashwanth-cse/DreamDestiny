APP_ENV=production

# Meta WhatsApp Cloud API Credentials
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
WHATSAPP_API_VERSION=v20.0
WHATSAPP_APP_SECRET=your_meta_app_secret

# Redis Configuration (Session & Locks)
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# Firestore Persistence (GCP / Firebase)
FIREBASE_PROJECT_ID=dream-destiny
GOOGLE_APPLICATION_CREDENTIALS=

# Existing Backend Gateway
PLANNER_GATEWAY_URL=http://planner-service:8000
GEMINI_API_KEY=

# State Machine & Concurrency Timeouts
CONVERSATION_TTL_SECONDS=172800
REQUEST_TIMEOUT_SECONDS=30
LOCK_TIMEOUT_SECONDS=10

LOG_LEVEL=INFO
