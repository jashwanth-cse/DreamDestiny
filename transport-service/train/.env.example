# Environment configurations
# Currently, the API keys and configurations are handled internally or in app/config.py
PORT=8000

# Optional: override default path to the preprocessed railway station dataset
# Default: auto-discovered at data/railway_stations.json relative to project root
# RAILWAY_STATIONS_DATA_PATH=/app/data/railway_stations.json

# Fuzzy match confidence threshold (Jaccard bigram similarity, 0.0–1.0, default 0.82)
# Increase to be more strict (fewer fuzzy hits), decrease to be more lenient
# FUZZY_CONFIDENCE_THRESHOLD=0.82
