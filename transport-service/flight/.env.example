# SerpApi Google Flights API Key
SERPAPI_API_KEY=your_serpapi_api_key_here

# Google Maps API Key (for geo-based nearest airport resolution)
# Same key used by route-service. Required for cities without a direct airport.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Service Port and HTTP Settings
FLIGHT_SERVICE_PORT=8006
HTTP_TIMEOUT=30.0
DEFAULT_CURRENCY=INR
FRONTEND_ORIGIN=http://localhost:3000

# Geo-nearest airport settings (optional, defaults shown)
MAX_AIRPORT_RADIUS_KM=500
GEOCODING_CACHE_TTL=86400
GEOCODING_CACHE_MAX_SIZE=512
